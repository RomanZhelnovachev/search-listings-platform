<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">


    <changeSet id="create-listing-mortgage-programs" author="RomanZhelnovachev">

        <createTable tableName="listing_mortgage_programs">

            <column name="listing_id" type="BIGINT">
                <constraints
                    nullable="false"
                    foreignKeyName="fk_listing_mortgage_programs_listing"
                    references="listings(id)"/>
            </column>

            <column name="mortgage_program_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addPrimaryKey
                tableName="listing_mortgage_programs"
                columnNames="listing_id, mortgage_program_id"
                constraintName="pk_listing_mortgage_programs"/>

    </changeSet>

</databaseChangeLog>