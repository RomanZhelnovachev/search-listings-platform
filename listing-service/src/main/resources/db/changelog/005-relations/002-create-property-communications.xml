<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">


    <changeSet id="create-property-communications" author="RomanZhelnovachev">

        <createTable tableName="property_communications">

            <column name="property_id" type="BIGINT">
                <constraints
                    nullable="false"
                    foreignKeyName="fk_property-communications_property"
                    references="properties(id)"/>
            </column>

            <column name="communication_id" type="BIGINT">
                <constraints
                    nullable="false"
                    foreignKeyName="fk_property-communications_communication"
                    references="communications(id)"/>
            </column>

        </createTable>

        <addPrimaryKey
                tableName="property-communications"
                columnNames="property_id, communication_id"
                constraintName="pk_property-communications"/>
    </changeSet>

</databaseChangeLog>