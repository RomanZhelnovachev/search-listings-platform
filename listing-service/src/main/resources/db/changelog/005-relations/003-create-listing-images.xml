<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">


    <changeSet id="create-listing-images" author="RomanZhelnovachev">

        <createTable tableName="listing_images">

            <column name="listing_id" type="BIGINT">
                <constraints
                    nullable="false"
                    foreignKeyName="fk_listing_images_listing"
                    references="listings(id)"/>
            </column>

            <column name="image_id" type="BIGINT">
                <constraints
                    nullable="false"
                    foreignKeyName="fk_listing_images_image"
                    references="images(id)"/>
            </column>

        </createTable>

        <addPrimaryKey
                tableName="listing_images"
                columnNames="listing_id, image_id"
                constraintName="pk_listing_images"/>

    </changeSet>

</databaseChangeLog>