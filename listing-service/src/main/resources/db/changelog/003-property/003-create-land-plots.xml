<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">


    <changeSet id="009-create-land-plots" author="RomanZhelnovachev">

        <createTable tableName="land_plots">

            <column name="id" type="BIGINT">
                <constraints
                    primaryKey="true"
                    nullable="false"/>
            </column>

            <column name="land_use_id" type="BIGINT"/>

            <column name="road" type="VARCHAR(255)"/>

            <column name="fencing" type="VARCHAR(255)"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="land_plots"
                baseColumnNames="id"
                constraintName="fk_land_plots_properties"
                referencedTableName="properties"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="land_plots"
                baseColumnNames="land_use_id"
                constraintName="fk_land_plots_land_use_types"
                referencedTableName="land_use_types"
                referencedColumnNames="id"/>

    </changeSet>

</databaseChangeLog>