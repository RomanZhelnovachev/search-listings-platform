<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-create-listing-additional-buildings" author="RomanZhelnovachev">

        <createTable tableName="listing_additional_buildings">

            <column name="listing_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="region" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="additional_building_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addPrimaryKey
                tableName="listing_additional_buildings"
                columnNames="listing_id, region, additional_building_id"
                constraintName="pk_listing_additional_buildings"/>

    </changeSet>

</databaseChangeLog>